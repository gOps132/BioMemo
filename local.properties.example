# Copy these into local.properties for local development.
# Never commit real API keys or secrets.

# Default Android Studio dev variant is prodDebug. These values are the fallback
# for prodDebug and prodRelease.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# Android Studio Build Variants:
# - prodDebug: SUPABASE_PROD_* when present, else SUPABASE_URL/SUPABASE_ANON_KEY
# - localDebug: SUPABASE_DEV_* when present, else SUPABASE_URL/SUPABASE_ANON_KEY
# - prodRelease: SUPABASE_PROD_* when present, else SUPABASE_URL/SUPABASE_ANON_KEY
# - localRelease: SUPABASE_DEV_* when present, else SUPABASE_URL/SUPABASE_ANON_KEY
SUPABASE_PROD_URL=
SUPABASE_PROD_ANON_KEY=
SUPABASE_DEV_URL=
SUPABASE_DEV_ANON_KEY=

GOOGLE_WEB_CLIENT_ID=
