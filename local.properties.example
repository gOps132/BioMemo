# Copy these into local.properties for local development.
# Never commit real API keys or secrets.

# Debug builds use these values directly. Release builds can use these values too,
# or the SUPABASE_PROD_* overrides below.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

SUPABASE_PROD_URL=
SUPABASE_PROD_ANON_KEY=

GOOGLE_WEB_CLIENT_ID=
AI_IDENTIFICATION_API_KEY=
