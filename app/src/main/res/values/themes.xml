<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.BioMemo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Changed from "sans" to "sans-serif" to fix a Layout Preview render issue
             where the renderer fails to resolve "sans" and crashes with a NullPointerException
             related to assetStream. -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/bio_forest_900</item>
        <item name="android:navigationBarColor">@color/bio_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="colorPrimary">@color/bio_forest_700</item>
        <item name="colorPrimaryVariant">@color/bio_forest_900</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/bio_leaf_500</item>
    </style>

    <style name="Theme.BioMemo" parent="Base.Theme.BioMemo" />
</resources>
