<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hero_gradient"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="32dp"
    android:paddingRight="32dp">

    <ImageView
        android:id="@+id/imageviewSplashLogo"
        android:layout_width="142dp"
        android:layout_height="142dp"
        android:contentDescription="BioMemo Logo"
        android:scaleType="fitCenter"
        android:src="@drawable/biomemo_icon_noborder" />

    <TextView
        android:id="@+id/textviewSplashTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="BioMemo"
        android:textColor="@color/white"
        android:textSize="42sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textviewSplashSlogan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Discover · Identify · Remember"
        android:textColor="#CDEED6"
        android:textSize="18sp" />
</LinearLayout>
